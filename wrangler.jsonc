{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "shama-website-new-2026",
  "main": "worker.js",
  "compatibility_date": "2026-09-08",
  "routes": [
    {
      "pattern": "shamaonline.com",
      "custom_domain": true
    },
    {
      "pattern": "www.shamaonline.com/*",
      "zone_name": "shamaonline.com"
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/video/*"
    ]
  }
}
