{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "shama-website-new-2026",
  "main": "worker.js",
  "compatibility_date": "2026-09-08",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/video/*"
    ]
  }
}
